# ==============================================================================
# AEGIS CENTRAL DATA GATEWAY - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production # development | staging | production
DEBUG=false
PROJECT_NAME="AEGIS UNIFIED DATA CORE"
VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# Security & Master AES-256 Encryption Key
# ENCRYPTION_KEY / AEGIS_SECRET_KEY: 32-byte url-safe base64 string
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_SECRET_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# JWT Secret & Signing Algorithm
JWT_SECRET=aegis_jwt_super_secret_signing_key_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Administrative Bootstrap Credentials
DEFAULT_ADMIN_EMAIL=admin@aegis.gov.in
DEFAULT_ADMIN_PASSWORD=AegisAdmin@2026!

# Client Application Authentication Keys (For Aegis Web & Aegis Alert App)
AEGIS_WEB_CLIENT_KEY=aegis_web_client_secure_key_2026
AEGIS_APP_CLIENT_KEY=aegis_app_client_secure_key_2026

# Database Connection (PostgreSQL 16 + PostGIS)
# For Docker Compose: host is 'postgres', port 5432
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_secure_password_2026
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_secure_password_2026@postgres:5432/aegis_db
DATABASE_SYNC_URL=postgresql://aegis_user:aegis_secure_password_2026@postgres:5432/aegis_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Broker
# For Docker Compose: host is 'redis', port 6379
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SEC=300

# Outbound SSRF & Network Protection
SSRF_PROTECTION_ENABLED=true
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=120

# Background Polling Scheduler
ENABLE_BACKGROUND_SCHEDULER=true
DEFAULT_INGESTION_INTERVAL_MINUTES=5

# External Provider Credentials (Stored ONLY on backend, encrypted at rest)
NASA_FIRMS_MAP_KEY=""
IMD_API_KEY=""
CWC_API_KEY=""
CPCB_API_KEY=""
OPEN_METEO_API_KEY=""
MAPS_ROUTING_KEY=""
GEMINI_API_KEY=""

# Cross-Origin Resource Sharing (CORS) - Allowed Web Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80,http://localhost
