# ==============================================================================
# AEGIS UNIFIED DATA CORE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AEGIS UNIFIED DATA CORE"
VERSION="2.0.0"
HOST="0.0.0.0"
PORT=8000

# Cryptographic Keys (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AEGIS_SECRET_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# JWT Authentication
JWT_SECRET="aegis_jwt_super_secret_signing_key_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Administrative Account Seed
DEFAULT_ADMIN_EMAIL="admin@aegis.gov.in"
DEFAULT_ADMIN_PASSWORD="AegisAdmin@2026!"

# Application Client API Keys
AEGIS_WEB_CLIENT_KEY="aegis_web_client_secure_key_2026"
AEGIS_APP_CLIENT_KEY="aegis_app_client_secure_key_2026"

# Authoritative Database (PostgreSQL 16 + PostGIS)
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_secure_password_2026
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_secure_password_2026@postgres:5432/aegis_db
DATABASE_SYNC_URL=postgresql://aegis_user:aegis_secure_password_2026@postgres:5432/aegis_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Realtime Pub/Sub & Caching Broker (Redis 7)
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SEC=300

# Security Guardrails & Rate Limiting
SSRF_PROTECTION_ENABLED=true
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=120

# Background Telemetry Ingestion Scheduler
ENABLE_BACKGROUND_SCHEDULER=true
DEFAULT_INGESTION_INTERVAL_MINUTES=5

# Push Notification Service Credentials (Optional for local dev, mandatory for real mobile delivery)
EXPO_ACCESS_TOKEN=""
FIREBASE_CREDENTIALS_PATH=""
APNS_KEY_PATH=""

# External Disaster Early Warning Providers
OPEN_METEO_API_KEY=""
NASA_FIRMS_MAP_KEY=""
IMD_API_KEY=""
CWC_API_KEY=""
CPCB_API_KEY=""
MAPS_ROUTING_KEY=""
GEMINI_API_KEY=""
