# ==============================================================================
# AEGIS CENTRAL DATA GATEWAY - ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production # development | staging | production
DEBUG=false
APP_NAME="AEGIS Unified Data Core"
APP_VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# Security & Master AES-256 Encryption Key
# ENCRYPTION_KEY / AEGIS_SECRET_KEY: 32-byte url-safe base64 string
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_SECRET_KEY="[GENERATE_32_BYTE_FERNET_KEY_HERE]"

# JWT Secret & Signing Algorithm
JWT_SECRET="[INSERT_SECURE_RANDOM_64_CHAR_JWT_SECRET_HERE]"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Administrative Bootstrap Credentials
DEFAULT_ADMIN_EMAIL="admin@aegis.gov.in"
DEFAULT_ADMIN_PASSWORD="[INSERT_STRONG_ADMIN_PASSWORD_HERE]"

# Client Application Authentication Keys (For Aegis Web & Aegis Alert App)
AEGIS_WEB_CLIENT_KEY="[INSERT_WEB_CLIENT_API_KEY_HERE]"
AEGIS_APP_CLIENT_KEY="[INSERT_APP_CLIENT_API_KEY_HERE]"

# Database Connection (PostgreSQL 16 + PostGIS)
DATABASE_URL="postgresql+asyncpg://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:5432/[DB_NAME]"
DATABASE_SYNC_URL="postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:5432/[DB_NAME]"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Broker
REDIS_URL="redis://[REDIS_HOST]:6379/0"
CACHE_DEFAULT_TTL_SEC=300

# Outbound SSRF & Network Protection
SSRF_PROTECTION_ENABLED=true
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=120

# Background Polling Scheduler
ENABLE_BACKGROUND_SCHEDULER=true
DEFAULT_INGESTION_INTERVAL_MINUTES=5

# External Provider Credentials (Stored ONLY on backend, encrypted at rest)
NASA_FIRMS_MAP_KEY="[INSERT_NASA_FIRMS_MAP_KEY_HERE]"
IMD_API_KEY="[INSERT_DATA_GOV_IN_OR_IMD_KEY_HERE]"
CWC_API_KEY="[INSERT_CWC_HYDROLOGY_KEY_HERE]"
CPCB_API_KEY="[INSERT_CPCB_AQI_KEY_HERE]"
OPEN_METEO_API_KEY="[OPTIONAL_OPEN_METEO_KEY_HERE]"
MAPS_ROUTING_KEY="[OPTIONAL_ROUTING_KEY_HERE]"
GEMINI_API_KEY="[OPTIONAL_GEMINI_AI_KEY_HERE]"

# Cross-Origin Resource Sharing (CORS) - Allowed Web Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
