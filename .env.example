# ==============================================================================
# AEGIS UNIFIED DATA CORE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production # development | staging | production
DEBUG=false
APP_NAME="AEGIS Unified Data Core"
APP_VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"
WORKERS=2

# Security & Secret Encryption
# ENCRYPTION_KEY must be a 32-byte url-safe base64-encoded string (Fernet key)
# Generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# JWT Authentication
JWT_SECRET_KEY="aegis_super_secret_jwt_key_multi_hazard_2026_secure"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL="postgresql+asyncpg://aegis_user:aegis_secure_password_2026@localhost:5432/aegis_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & In-Memory Store
REDIS_URL="redis://localhost:6379/0"
REDIS_TTL_SECONDS=300

# Outbound SSRF & Network Protection
SSRF_GUARD_ENABLED=true
HTTP_REQUEST_TIMEOUT_SECONDS=10
MAX_EXTERNAL_PAYLOAD_BYTES=10485760 # 10 MB

# External Provider Credentials (Encrypted at rest once ingested)
IMD_API_KEY=""
CWC_API_KEY=""
NASA_FIRMS_MAP_KEY=""
CPCB_API_KEY=""

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
