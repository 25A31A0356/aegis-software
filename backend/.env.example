# ==============================================================================
# AEGIS Multi-Hazard Disaster Intelligence Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets or production credentials to version control.

# ------------------------------------------------------------------------------
# 1. Project & Environment Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AEGIS UNIFIED DATA CORE"
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development                # development | staging | production
DEBUG=false
ENABLE_DEV_MOCKS=false

# ------------------------------------------------------------------------------
# 2. Server Binding & Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000","http://localhost"]

# ------------------------------------------------------------------------------
# 3. Database & Spatial Engine (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# Async driver format for SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://aegis_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/aegis_db
# Sync driver format for Alembic migrations
DATABASE_SYNC_URL=postgresql://aegis_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/aegis_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 4. Redis Cache & Realtime Event Broker (Pub/Sub & Streams)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SEC=300

# ------------------------------------------------------------------------------
# 5. Security, JWT Authentication & RBAC
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AEGIS_SECRET_KEY=CHANGE_ME_BASE64_32_BYTE_ENCRYPTION_KEY
JWT_SECRET=CHANGE_ME_SECURE_RANDOM_JWT_SECRET_STRING_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080      # 7 days

# Default System Administrator Bootstrap (Development Only)
DEFAULT_ADMIN_EMAIL=admin@aegis.gov.in
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_2026!

# Application Client API Keys (Mobile & Web Integration Keys)
AEGIS_WEB_CLIENT_KEY=CHANGE_ME_WEB_CLIENT_KEY_2026
AEGIS_APP_CLIENT_KEY=CHANGE_ME_APP_CLIENT_KEY_2026

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Outbound HTTP Security (SSRF Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
SSRF_PROTECTION_ENABLED=true
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 7. External Data Ingestion & Notification Credentials
# ------------------------------------------------------------------------------
# Meteorological & Earth Science APIs (Optional - Fallbacks available)
NASA_FIRMS_MAP_KEY=
IMD_API_KEY=
CWC_API_KEY=
CPCB_API_KEY=
OPEN_METEO_API_KEY=
MAPS_ROUTING_KEY=

# Artificial Intelligence & Decision Support
GEMINI_API_KEY=

# Push Notification & SMS Dispatch (Production Only)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 8. Background Ingestion & Realtime Dispatch Parameters
# ------------------------------------------------------------------------------
ENABLE_BACKGROUND_SCHEDULER=true
DEFAULT_INGESTION_INTERVAL_MINUTES=5
SOS_INITIAL_RADIUS_KM=10.0
SOS_MAX_RADIUS_KM=20.0
SOS_EXPIRATION_MINUTES=60
SOS_OFFER_TIMEOUT_SECONDS=45
SOS_ROUTE_RECALC_METERS=150.0
SOS_MAX_CANDIDATES=10
